{
  "name": "adpl-pptx-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ADPL PowerPoint (.pptx) creation studio - sky blue corporate template",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:export && npm run test:render",
    "test:export": "esbuild test/export.test.mjs --bundle --platform=node --format=cjs --outfile=.tmp/export-test.cjs --log-level=warning && node .tmp/export-test.cjs",
    "test:render": "esbuild test/render.test.mjs --bundle --platform=node --format=cjs --loader:.css=empty --outfile=.tmp/render-test.cjs --log-level=warning && node .tmp/render-test.cjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "^0.21.5"
  }
}
